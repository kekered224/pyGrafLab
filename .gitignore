# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Testing / Coverage ----
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ---- Runtime directories (regenerated by the server) ----
# output/ holds CLI and web products; output/uploads/ holds uploaded models.
output/*
!output/.gitkeep

# ---- Model files -----------------------------------------------------
# Downloaded models stay local. The one tracked exception is the degree-180
# EIGEN-6C4 subset, so a fresh clone can run the example and the tests.
GGM/*.gfc
!GGM/EIGEN-6C4_n180.gfc
*.grx
